{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docker-debug-up",
      "type": "process",
      "command": "docker",
      "options": { "cwd": "${workspaceFolder}" },
      "args": [
        "compose",
        "-f",
        "docker-compose.yml",
        "-f",
        "docker-compose.debug.yml",
        "up",
        "--build",
        "--force-recreate",
        "-d",
        "my-app"
      ],
      "problemMatcher": []
    },
    {
      "label": "docker-debug-down",
      "type": "process",
      "command": "docker",
      "options": { "cwd": "${workspaceFolder}" },
      "args": [
        "compose",
        "-f",
        "docker-compose.yml",
        "-f",
        "docker-compose.debug.yml",
        "down"
      ],
      "problemMatcher": []
    }
  ]
}
